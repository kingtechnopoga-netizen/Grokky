# Copy this file to .env for local development. Never commit your real .env.
# On Render, set these in the dashboard (Environment tab) instead.

# Required — get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional — comma-separated list of origins allowed to call this API.
# Use "*" while developing; tighten to your real domain in production.
# Example: ALLOWED_ORIGINS=https://grokky.onrender.com,http://localhost:8000
ALLOWED_ORIGINS=*

# Optional — which Claude model to use. Haiku is cheap & fast and perfect for prompt rewriting.
CLAUDE_MODEL=claude-3-5-haiku-latest

# Optional — port to listen on (Render sets this automatically).
PORT=10000
